#include <windows.h>
#include "ui.h"

IDD_ACCOUNT DIALOGEX 0, 0, 470, 352
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PIU Companion settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Players", -1, 14, 12, 442, 12
    LTEXT "Profiles follow players automatically when they swap P1 / P2 sides.", -1, 14, 27, 442, 12
    GROUPBOX "Account 1", -1, 14, 46, 216, 132
    LTEXT "XSanity &profile", -1, 26, 60, 190, 11
    EDITTEXT IDC_PROFILE1, 26, 74, 192, 17, ES_AUTOHSCROLL
    LTEXT "PIU Scores API &key", -1, 26, 98, 192, 11
    EDITTEXT IDC_TOKEN, 26, 112, 192, 17, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL "Include &failed PBs", IDC_FAILED1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 136, 192, 12
    LTEXT "", IDC_PENDING1, 26, 156, 94, 12
    PUSHBUTTON "Discard pending...", IDC_DISCARD1, 124, 153, 94, 18
    LTEXT "", IDC_STATUS, 14, 184, 442, 12, SS_NOPREFIX | SS_ENDELLIPSIS
    GROUPBOX "Account 2 (optional)", -1, 240, 46, 216, 132
    LTEXT "XSanity p&rofile", -1, 252, 60, 192, 11
    EDITTEXT IDC_PROFILE2, 252, 74, 192, 17, ES_AUTOHSCROLL
    LTEXT "PIU Scores API ke&y", -1, 252, 98, 192, 11
    EDITTEXT IDC_TOKEN2, 252, 112, 192, 17, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL "Include failed P&Bs", IDC_FAILED2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 252, 136, 192, 12
    LTEXT "", IDC_PENDING2, 252, 156, 94, 12
    PUSHBUTTON "Discard pending...", IDC_DISCARD2, 350, 153, 94, 18
    LTEXT "", IDC_STATUS2, 14, 200, 442, 12, SS_NOPREFIX | SS_ENDELLIPSIS
    GROUPBOX "Screenshots", -1, 14, 220, 442, 86
    CONTROL "Save &screenshots of PBs", IDC_SCREENSHOTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 232, 300, 12
    LTEXT "Screenshot &folder", -1, 26, 253, 300, 11
    EDITTEXT IDC_SCREENSHOT_FOLDER, 26, 267, 272, 17, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_SCREENSHOT_BROWSE, 306, 266, 64, 19
    PUSHBUTTON "Open folder", IDC_SCREENSHOT_OPEN, 378, 266, 66, 19
    LTEXT "", IDC_SCREENSHOT_STATUS, 26, 289, 418, 12, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "&Mix", -1, 14, 326, 24, 11
    COMBOBOX IDC_MIX, 40, 321, 82, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Open PIU Scores", IDC_WEBSITE, 134, 321, 101, 20
    DEFPUSHBUTTON "Save", IDOK, 316, 321, 66, 20
    PUSHBUTTON "Cancel", IDCANCEL, 390, 321, 66, 20
END

IDD_SETUP DIALOGEX 0, 0, 350, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_COMPOSITED
CAPTION "XSanity companion setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "XSanity companion", IDC_TITLE, 0, 0, 1, 1
    LTEXT "", IDC_INTRO, 0, 0, 1, 1
    LTEXT "COMPONENTS", IDC_COMPONENTS, 0, 0, 1, 1
    CONTROL "&Automatic PB syncing", IDC_SYNC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "&OBS overlay (optional)", IDC_OVERLAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    LTEXT "&XSanity folder", IDC_FOLDER_LABEL, 0, 0, 1, 1
    EDITTEXT IDC_ROOT, 0, 0, 1, 1, ES_AUTOHSCROLL
    PUSHBUTTON "&Browse...", IDC_BROWSE, 0, 0, 1, 1
    CONTROL "Open &companion after setup", IDC_LAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    LTEXT "", IDC_STATUS, 0, 0, 1, 1
    LTEXT "", IDC_DETAILS, 0, 0, 1, 1
    DEFPUSHBUTTON "&Install", IDC_APPLY, 0, 0, 1, 1
    PUSHBUTTON "&Close", IDCANCEL, 0, 0, 1, 1
END
