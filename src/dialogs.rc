#include <windows.h>
#include "ui.h"

IDD_ACCOUNT DIALOGEX 0, 0, 400, 306
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PIU Scores accounts"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Link each XSanity profile to its own PIU Scores API key.", -1, 14, 12, 372, 12
    LTEXT "Profiles follow players automatically when they swap P1 / P2 sides.", -1, 14, 27, 372, 12
    GROUPBOX "Account 1", -1, 14, 46, 372, 82
    LTEXT "XSanity &profile", -1, 26, 62, 112, 11
    LTEXT "PIU Scores API &key", -1, 158, 62, 210, 11
    EDITTEXT IDC_PROFILE1, 26, 76, 122, 17, ES_AUTOHSCROLL
    EDITTEXT IDC_TOKEN, 158, 76, 214, 17, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "", IDC_PENDING1, 26, 105, 240, 12
    PUSHBUTTON "Discard pending...", IDC_DISCARD1, 277, 101, 95, 18
    GROUPBOX "Account 2 (optional)", -1, 14, 137, 372, 82
    LTEXT "XSanity p&rofile", -1, 26, 153, 112, 11
    LTEXT "PIU Scores API ke&y", -1, 158, 153, 210, 11
    EDITTEXT IDC_PROFILE2, 26, 167, 122, 17, ES_AUTOHSCROLL
    EDITTEXT IDC_TOKEN2, 158, 167, 214, 17, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "", IDC_PENDING2, 26, 196, 240, 12
    PUSHBUTTON "Discard pending...", IDC_DISCARD2, 277, 192, 95, 18
    LTEXT "", IDC_STATUS, 14, 229, 372, 12, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "", IDC_STATUS2, 14, 245, 372, 12, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "&Mix", -1, 14, 280, 24, 11
    COMBOBOX IDC_MIX, 40, 275, 82, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Open PIU Scores", IDC_WEBSITE, 133, 275, 101, 20
    DEFPUSHBUTTON "Save", IDOK, 246, 275, 66, 20
    PUSHBUTTON "Cancel", IDCANCEL, 320, 275, 66, 20
END

IDD_SETUP DIALOGEX 0, 0, 350, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_COMPOSITED
CAPTION "XSanity companion setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "XSanity companion", IDC_TITLE, 0, 0, 1, 1
    LTEXT "", IDC_INTRO, 0, 0, 1, 1
    LTEXT "COMPONENTS", IDC_COMPONENTS, 0, 0, 1, 1
    CONTROL "&Automatic PB syncing", IDC_SYNC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "&OBS overlay (optional)", IDC_OVERLAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    LTEXT "&XSanity folder", IDC_FOLDER_LABEL, 0, 0, 1, 1
    EDITTEXT IDC_ROOT, 0, 0, 1, 1, ES_AUTOHSCROLL
    PUSHBUTTON "&Browse...", IDC_BROWSE, 0, 0, 1, 1
    CONTROL "Open &companion after setup", IDC_LAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    LTEXT "", IDC_STATUS, 0, 0, 1, 1
    LTEXT "", IDC_DETAILS, 0, 0, 1, 1
    DEFPUSHBUTTON "&Install", IDC_APPLY, 0, 0, 1, 1
    PUSHBUTTON "&Close", IDCANCEL, 0, 0, 1, 1
END
