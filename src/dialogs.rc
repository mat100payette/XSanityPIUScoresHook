#include <windows.h>
#include "ui.h"

IDD_ACCOUNT DIALOGEX 0, 0, 330, 177
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PIU Scores account"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Connect your PIU Scores account", -1, 14, 12, 298, 14
    LTEXT "Personal API token", -1, 14, 34, 298, 11
    EDITTEXT IDC_TOKEN, 14, 48, 302, 16, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Mix", -1, 14, 75, 45, 11
    COMBOBOX IDC_MIX, 62, 72, 110, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Open PIU Scores", IDC_WEBSITE, 214, 72, 102, 18
    LTEXT "", IDC_STATUS, 14, 103, 302, 34
    DEFPUSHBUTTON "Save", IDOK, 170, 145, 70, 20
    PUSHBUTTON "Cancel", IDCANCEL, 246, 145, 70, 20
END

IDD_SETUP DIALOGEX 0, 0, 350, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "XSanity companion setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "XSanity companion", IDC_TITLE, 0, 0, 1, 1
    LTEXT "", IDC_INTRO, 0, 0, 1, 1
    LTEXT "COMPONENTS", IDC_COMPONENTS, 0, 0, 1, 1
    CONTROL "&Automatic PB syncing", IDC_SYNC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "&OBS overlay (optional)", IDC_OVERLAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    LTEXT "&XSanity folder", IDC_FOLDER_LABEL, 0, 0, 1, 1
    EDITTEXT IDC_ROOT, 0, 0, 1, 1, ES_AUTOHSCROLL
    PUSHBUTTON "&Browse...", IDC_BROWSE, 0, 0, 1, 1
    CONTROL "Open &companion after setup", IDC_LAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 1, 1
    LTEXT "", IDC_STATUS, 0, 0, 1, 1
    LTEXT "", IDC_DETAILS, 0, 0, 1, 1
    DEFPUSHBUTTON "&Install", IDC_APPLY, 0, 0, 1, 1
    PUSHBUTTON "&Close", IDCANCEL, 0, 0, 1, 1
END
